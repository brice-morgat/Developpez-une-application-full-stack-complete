{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "unit": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "coverage:e2e:clean": "rimraf .nyc_output coverage/cypress",
    "coverage:e2e:serve": "ng run front:serve-e2e-coverage --host 127.0.0.1 --port 4201",
    "coverage:e2e:run": "cypress run --config baseUrl=http://127.0.0.1:4201",
    "coverage:e2e:report": "nyc report --temp-dir .nyc_output --report-dir coverage/cypress --reporter=html --reporter=text-summary",
    "coverage:e2e": "npm run coverage:e2e:clean && concurrently -k -s first \"npm:coverage:e2e:serve\" \"wait-on http://127.0.0.1:4201 && npm run coverage:e2e:run && npm run coverage:e2e:report\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ngxs/storage-plugin": "^19.0.0",
    "@ngxs/store": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^19.0.0-beta.0",
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "~19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@babel/core": "^7.29.0",
    "@cypress/code-coverage": "^4.0.3",
    "@types/jasmine": "~4.0.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^7.0.1",
    "concurrently": "^9.2.1",
    "cypress": "^15.13.0",
    "jasmine-core": "~4.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.7.2",
    "wait-on": "^9.0.4"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/app/**/*.ts"
    ],
    "exclude": [
      "**/*.spec.ts",
      "**/*.cy.ts",
      "cypress/**",
      "src/**/*.module.ts",
      "src/main.ts",
      "src/polyfills.ts",
      "src/test.ts"
    ],
    "extension": [
      ".ts"
    ],
    "report-dir": "coverage/cypress",
    "temp-dir": ".nyc_output"
  }
}
